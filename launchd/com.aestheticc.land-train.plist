<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LUCY-z3ykz.4: tells the orchestrator when a land train opens (skills/land-batch/TRAINS.json).
     NOT loaded. The Manager enables it after the deploy:
       cp ~/.claude/launchd/com.aestheticc.land-train.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.aestheticc.land-train.plist
     Runs every 15 min; trains.py announces once per train per day using TRAINS.json's
     own timezone, so a changed laptop clock never moves the trains. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.aestheticc.land-train</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/shane/.claude/skills/land-batch/bin/trains.py</string>
        <string>announce</string>
    </array>
    <key>StartInterval</key><integer>900</integer>
    <key>RunAtLoad</key><false/>
    <key>StandardOutPath</key><string>/Users/shane/.claude/fleet/land-train.out.log</string>
    <key>StandardErrorPath</key><string>/Users/shane/.claude/fleet/land-train.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/shane/.local/bin</string>
    </dict>
</dict>
</plist>
