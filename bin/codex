#!/bin/bash
# codex PATH shim (LUCY-b3hf5): refuses any codex call attributable to a Claude-only
# client's bead, then execs the real codex. Same pattern as bin/bd (bd-close-guard);
# ~/.claude/bin is first on PATH via ~/.zshrc. The bead comes from $BEAD_ID/$EPIC_ID/
# $CHILD_ID or the git branch of --cd/-C and the cwd; see scripts/claude_only_guard.py.
# MARKER: claude-only-codex-shim (a worktree copy of this file also on PATH is skipped, not exec'd)
set -uo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
GUARD="$(dirname "$SELF")/../scripts/claude_only_guard.py"

case "${1:-}" in
  --version|-V|--help|-h|help|login|logout|completion) ;;  # nothing leaves the machine
  *)
    python3 "$GUARD" exec-check -- "$@" || exit $?
    ;;
esac

IFS=: read -ra DIRS <<< "${PATH:-}"
for d in "${DIRS[@]}"; do
  cand="$d/codex"
  [ -x "$cand" ] && [ ! -d "$cand" ] || continue
  real="$(cd "$(dirname "$cand")" 2>/dev/null && pwd -P)/codex"
  [ "$real" = "$SELF" ] && continue
  grep -q 'MARKER: claude-only-codex-shim' "$cand" 2>/dev/null && continue
  exec "$cand" "$@"
done
echo "codex shim: no real codex found on PATH" >&2
exit 127
