#!/bin/sh
"exec" "/usr/bin/env" "PATH=/opt/homebrew/bin:/usr/bin:/bin" "python3" "-I" "-S" "$0" "$@"
"""run-gate: run a gate script from the committed live export, never the checkout (LUCY-wqn96 / p122j).

Usage: <git-common-dir>/live/run-gate [--fail-exit N] <relpath> [args...]
       e.g. ~/.claude/.git/live/run-gate scripts/review-gate.sh <bead> <tip> ...

install.sh copies this file to <git-common-dir>/live/run-gate; callers use that copy. It
finds its repo from its own location, then refuses (exit 3, or N with --fail-exit) unless:
  - live/current names a commit equal to refs/heads/main (it waits ~2 s for the
    reference-transaction hook's export to catch up after a main move), and
  - every file under live/<main> is exactly main's gate blob, with nothing extra or missing
    (GATE_PATHS is read from the installed hook, the one definition), and
  - <relpath> is one of those files.
Then it pins the export (a shared flock on live/pins/<oid>.lock, inherited across exec, so
the exporter's cleanup keeps that export while the gate or any child still runs) and execs the
exported file with the caller's cwd: a .py entry as python3 -I with its
own dir on sys.path (so sibling imports resolve inside the export), a .mjs/.cjs/.js entry
with node, anything else by its shebang, or bash for a non-executable .sh.

Claude Code treats a hook exit of 2 as blocking and any other non-zero as a warning, so a
PreToolUse guard routed through this passes --fail-exit 2 to fail closed. Every refusal,
including any exception while checking, exits with that code.

The environment is an ALLOWLIST (LUCY-p122j r8): the gate, and every check before it, sees
only the caller variables named in ENV_ALLOW / ENV_ALLOW_PREFIXES below. Anything else is
dropped, so a variable that points a gate at other code (PGLITE_ENTRY, a tarball, a script,
NODE_OPTIONS, PYTHON*, BASH_FUNC_*, a future *_ENTRY) is gone without being named. PATH is
fixed, and set before the first git call: the export's own bin/ first (main's committed bd
close-guard, so a gate's `bd close` is always checked), then system and Homebrew dirs (so no
user dir can shadow node, python3, git or bash), then the user dirs. run-gate itself runs on
the first python3 in those system dirs. Its first line is /bin/sh, not `env python3`: env would
search the caller's PATH for python3 before a line of this file ran, so the sh line (a no-op
string to Python) execs python3 from fixed dirs, and started as `<some python> run-gate` it
re-execs into that python3. CLAUDE_LIVE_ROOT is set to the verified export dir for gates that need a root.
"""
import os
import sys

# Fixed tool dirs: today's python3/node/git/bash, never a user-dir or checkout lookalike.
SYSTEM_PATH = ("/opt/homebrew/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin")


def trusted_python():
    for d in SYSTEM_PATH:
        p = os.path.join(d, "python3")
        if os.access(p, os.X_OK):
            return p
    return sys.executable


if __name__ == "__main__":
    _py = trusted_python()
    if (not (sys.flags.isolated and sys.flags.no_site)
            or os.path.realpath(sys.executable) != os.path.realpath(_py)):
        os.execv(_py, [_py, "-I", "-S", os.path.abspath(__file__)] + sys.argv[1:])

import importlib.machinery  # noqa: E402
import importlib.util  # noqa: E402
import pwd  # noqa: E402
import time  # noqa: E402

DRIFT = 3
CATCH_UP_S = 2.0
# A .py gate whose export disappears mid-run (only same-uid tampering can, given the pin) exits
# with the caller's --fail-exit code, never a bare traceback's 1. Exports are read-only (0555);
# the exporter's remove_tree makes a directory writable before deleting it, so a writable root
# means the export is partly gone even while the directory still exists.
PY_BOOT = """import os, runpy, sys
fail, root, p = int(sys.argv[1]), sys.argv[2], sys.argv[3]
sys.argv = sys.argv[3:]
sys.path.insert(0, os.path.dirname(p))
try:
    runpy.run_path(p, run_name='__main__')
except SystemExit:
    raise
except BaseException:
    if os.path.isdir(root) and not os.access(root, os.W_OK):
        raise
    sys.stderr.write('run-gate: live export %s vanished mid-run; refuse\\n' % root)
    sys.exit(fail)
"""


# The export's bin/ (only bin/bd, the bead close-guard, is a gate path) comes first: Homebrew
# has a bd too, and a gate must reach the real one only through the wrapper, which finds it as
# the first other bd on PATH. Then SYSTEM_PATH. The user dirs after them hold the tools gates
# call that live nowhere else: claude (~/.local/bin), the codex wrapper (~/.claude/bin), npx
# (~/.npm-global/bin).
USER_PATH = (".local/bin", ".claude/bin", ".npm-global/bin")

# The caller variables a gate may see; everything else is dropped (LUCY-p122j r8 E1). Each
# value is data (a name, a dir, a flag, a socket, a credential), never code a gate runs.
# Adding a name: it must not select code. test_gate_boundary_lint.py fails when an exported
# gate reads a variable that is in neither this list nor ENV_DROPPED.
ENV_ALLOW = frozenset((
    # identity, terminal, locale, temp
    "HOME", "USER", "LOGNAME", "SHELL", "TERM", "TERMINFO", "COLORTERM", "TERM_PROGRAM",
    "NO_COLOR", "FORCE_COLOR", "COLUMNS", "LINES", "TZ", "TMPDIR", "LANG", "LANGUAGE",
    "__CF_USER_TEXT_ENCODING", "SECURITYSESSIONID",
    # network: the Claude Code sandbox routes every connection through its proxy, and git's
    # ssh through GIT_SSH_COMMAND + inline GIT_CONFIG_* (prefixes below). These select code
    # outside ~/.claude (the sandbox's own), so they stay; dropping them breaks git fetch.
    "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY", "FTP_PROXY", "GRPC_PROXY",
    "RSYNC_PROXY", "http_proxy", "https_proxy", "all_proxy", "no_proxy", "ftp_proxy",
    "grpc_proxy", "DOCKER_HTTP_PROXY", "DOCKER_HTTPS_PROXY", "SSL_CERT_FILE",
    "REQUESTS_CA_BUNDLE", "NODE_EXTRA_CA_CERTS", "SSH_AUTH_SOCK", "SANDBOX_RUNTIME",
    "SRT_SSH_PROXY_COMMAND", "GIT_SSH_COMMAND", "GIT_CONFIG_COUNT", "GIT_CONFIG_PARAMETERS",
    "GIT_CONFIG_GLOBAL", "GIT_CONFIG_NOSYSTEM", "DOCKER_HOST",
    # git: which repo / index / author the caller is working in
    "GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_TERMINAL_PROMPT", "GIT_AUTHOR_NAME",
    "GIT_AUTHOR_EMAIL", "GIT_COMMITTER_NAME", "GIT_COMMITTER_EMAIL",
    # Claude Code / Codex session identity and config (CLAUDE_CODE_* is a prefix below)
    "CLAUDECODE", "CLAUDE_PROJECT_DIR", "CLAUDE_ENV_FILE", "CLAUDE_CONFIG_DIR",
    "CLAUDE_SESSION_ID", "CLAUDE_SESSION_NAME", "CLAUDE_JOB_DIR", "CLAUDE_TMPDIR", "CLAUDE_PID",
    "CLAUDE_EFFORT", "CODEX_THREAD_ID", "SPAWNED_SESSION", "AI_AGENT",
    # credentials and cloud project for the CLIs gates call (gh, gcloud, claude, codex)
    "GH_TOKEN", "GITHUB_TOKEN", "GOOGLE_APPLICATION_CREDENTIALS", "GOOGLE_CLOUD_PROJECT",
    "ANTHROPIC_API_KEY", "OPENAI_API_KEY", "GEMINI_API_KEY",
    # what exported gates read (found by test_gate_boundary_lint.py): data dirs, state files,
    # flags, limits
    "BEADS_DIR", "BEAD_ID", "AESTHETICC_REPO", "TARGET_REPO", "REPO", "PROJECT_PATH",
    "PROJECT_DIR", "WORKTREE_BASE", "ASK_GUARD_SILENCE_HOURS", "PRESENCE_STATE_DIR",
    "CONDUCTOR_ALLOW_DEPLOY_STAGING", "GATE_LEDGER", "GATE_WATCH_CACHE", "GBRAIN_INGEST_SUBPROCESS",
    "HEAVY_GATE_DIR", "PG_LANE_LOCK_DIR", "JEV_MODEL", "JEV_BELAY_CHECK", "JEV_BELAY_DEBUG",
    # a pg-lane-lock holder's token, so a gate it runs re-enters the lock (r8 independent)
    "PG_LANE_LOCK_TOKEN",
    "LAND_BATCH_BEADS_FILES", "LAND_BATCH_REF_SNAPSHOT", "LAND_BATCH_RETIRED_FILE",
    "LAND_BATCH_STATE_DIR", "LAND_REVIEWS_DIR", "LAND_SKIP_BEAD_COMMENTS", "RETIRED_FILE",
    "MORNING_REPORT_LOCK", "NIGHT_BATCH_ROOT", "NIGHT_BATCH_DREAM_ROOT", "NIGHT_BATCH_SLACK_ENV",
    "NIGHT_BATCH_TODO", "NIGHT_BATCH_WORKTREES", "SHANE_SLACK_USER_ID", "SLACK_BOT_TOKEN",
    "OBSERVER_DIR", "OBSERVER_REMIND_INTERVAL", "SENTRY_TRIAGE_DRY_RUN", "SENTRY_TRIAGE_FORCE",
    "STATE_FILE", "OUTPUT_FILE", "SUMMARY", "BLOCKER_COUNT", "ORCH_DISPATCHED",
    "SMGUARD_CONTEXT_WINDOW", "SMGUARD_DEADLINE_S", "WQN96_TEST_TIMEOUT_S",
    "LAND_GATE_REMOTE", "RUN_PG_TESTS", "GIT_OPTIONAL_LOCKS",
))
ENV_ALLOW_PREFIXES = ("LC_", "CLAUDE_CODE_", "FLEET_", "GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_",
                      "CLOUDSDK_PROXY_")
# Read by an exported gate, deliberately NOT passed: each names code for the gate (or its
# interpreter) to load. Listed only so the lint can tell "decided" from "forgotten"; any name
# outside ENV_ALLOW is dropped whether or not it is here. Gates that set one for their own
# child (migration_batch.py sets PGLITE_ENTRY, discover.sh LAND_BATCH_LIB_DIR) still can.
ENV_DROPPED = frozenset((
    "PATH", "PGLITE_ENTRY", "LAND_BATCH_PGLITE_TARBALL", "LAND_BATCH_LIB_DIR",
    "GATE_WATCH_SWEEP", "GATE_WATCH_ROLE", "LAND_STATE_SCRIPT", "SESSIONS_SCRIPT",
    "BASH_ENV", "ENV", "NODE_OPTIONS", "NODE_PATH", "JAVA_TOOL_OPTIONS", "GIT_EXEC_PATH",
    "CLAUDE_LIVE_ROOT",  # run-gate sets it (with PATH) itself; a caller's value never passes
))


def env_allowed(name):
    return name in ENV_ALLOW or name.startswith(ENV_ALLOW_PREFIXES)


def base_env():
    """The caller's allowlisted variables, PATH set to SYSTEM_PATH only."""
    env = {k: v for k, v in os.environ.items() if env_allowed(k)}
    env["PATH"] = ":".join(SYSTEM_PATH)
    return env


def gate_env(root, base):
    env = dict(base)
    home = env.get("HOME") or pwd.getpwuid(os.getuid()).pw_dir
    env["PATH"] = ":".join((os.path.join(root, "bin"),) + SYSTEM_PATH
                           + tuple(os.path.join(home, d) for d in USER_PATH))
    env["CLAUDE_LIVE_ROOT"] = root
    return env


def refuse(code, why):
    sys.stderr.write("run-gate: live export drift; refuse (%s)\n" % why)
    return code


def load_hook(common):
    path = os.path.join(common, "hooks", "reference-transaction")
    loader = importlib.machinery.SourceFileLoader("wqn96_reference_transaction", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def pin(hook, live, oid):
    """Hold a shared flock on live/pins/<oid>.lock for the gate's lifetime, or False.

    The fd is inheritable, so it survives exec and is shared by the gate's children: the
    exporter's cleanup never removes an export while anyone holds its pin. A pin file that
    cleanup unlinked while we waited is not a pin, and an export already gone is refused.
    """
    path = os.path.join(live, hook.PINS, oid + ".lock")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    for _ in range(3):
        fd = hook.acquire(path, hook.fcntl.LOCK_SH, CATCH_UP_S)
        if fd is None:
            return False
        try:
            linked = os.fstat(fd).st_ino == os.stat(path).st_ino
        except FileNotFoundError:
            linked = False
        if linked and os.path.isdir(os.path.join(live, oid)):
            os.set_inheritable(fd, True)
            return True
        os.close(fd)
        if not os.path.isdir(os.path.join(live, oid)):
            return False
    return False


def main(argv):
    fail = DRIFT
    if argv[:1] == ["--fail-exit"] and len(argv) >= 2:
        if not argv[1].isdigit() or not 1 <= int(argv[1]) <= 255:
            return refuse(DRIFT, "--fail-exit takes 1-255")
        fail, argv = int(argv[1]), argv[2:]
    try:
        return run(argv, fail)
    except BaseException as exc:  # noqa: BLE001 - any failure while checking is a refusal
        return refuse(fail, "%s: %s" % (type(exc).__name__, exc))


def run(argv, fail):
    if not argv:
        return refuse(fail, "usage: run-gate [--fail-exit N] <relpath> [args...]")
    rel = os.path.normpath(argv[0])
    if os.path.isabs(rel) or rel.split(os.sep)[0] in ("..", "."):
        return refuse(fail, "%s is not a repo-relative path" % argv[0])

    live = os.path.dirname(os.path.abspath(__file__))
    common = os.path.dirname(live)
    # Before the first git call: from here on, this process and every check it runs see only
    # the allowlisted variables and the fixed PATH (LUCY-p122j r8 E2).
    base = base_env()
    os.environ.clear()
    os.environ.update(base)
    caller_git_dir = os.environ.get("GIT_DIR")

    def own_repo(on):
        """Point the hook's git() at this repo whatever the cwd, then give the caller its GIT_DIR back."""
        if on:
            os.environ["GIT_DIR"] = common
        elif caller_git_dir is None:
            os.environ.pop("GIT_DIR", None)
        else:
            os.environ["GIT_DIR"] = caller_git_dir

    own_repo(True)
    try:
        hook = load_hook(common)
    except Exception as exc:  # noqa: BLE001
        return refuse(fail, "cannot load the installed hook: %s" % exc)
    finally:
        own_repo(False)

    def check():
        """(problem or None, the verified export's commit)."""
        own_repo(True)
        try:
            current, tip = hook.live_current(), hook.main_tip()
            if current is None:
                return "no live/current export", None
            if current != tip:
                return "live/current %s is not main %s" % (current[:12], (tip or "missing")[:12]), None
            problems = hook.export_drift(os.path.join(live, current), current)
            if problems:
                return "; ".join(problems[:5]), None
            if rel not in hook.gate_tree(current):
                return "%s is not a gate file at main" % rel, None
            return None, current
        finally:
            own_repo(False)

    deadline = time.monotonic() + CATCH_UP_S
    why, current = check()
    while why and "is not main" in why and time.monotonic() < deadline:
        time.sleep(0.2)
        why, current = check()
    if why:
        return refuse(fail, why)

    # The verified directory, not the current link: the link may move after the check.
    root = os.path.join(live, current)
    if not pin(hook, live, current):
        return refuse(fail, "cannot pin export %s" % current[:12])
    entry = os.path.join(root, rel)
    args = argv[1:]
    if rel.endswith(".py"):
        cmd = [sys.executable, "-I", "-c", PY_BOOT, str(fail), root, entry] + args
    elif rel.endswith((".mjs", ".cjs", ".js")):
        cmd = ["node", entry] + args
    elif os.access(entry, os.X_OK):
        cmd = [entry] + args
    elif rel.endswith(".sh"):
        cmd = ["bash", entry] + args
    else:
        return refuse(fail, "%s is not runnable" % rel)
    env = gate_env(root, base)
    try:
        os.execvpe(cmd[0], cmd, env)
    except OSError as exc:
        return refuse(fail, "cannot exec %s: %s" % (rel, exc))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
