#!/usr/bin/env -S python3 -I -S
"""reference-transaction hook: only the orchestrator moves main onto a gate-path change (LUCY-wqn96).

Git runs this for every ref update, whatever the route: commit (with or without
--no-verify), merge/fast-forward, cherry-pick, reset, update-ref, local push, from any
linked worktree. In state "prepared" a non-zero exit aborts the whole transaction, so
the ref is left where it was.

Rule: an update of refs/heads/main whose old..new diff touches a GATE_PATHS entry, and
any deletion or creation of main, is refused unless the caller is the fleet orchestrator.
While main is a symbolic ref, any update of it or of its target is refused the same way,
and so is turning main into a symbolic ref.
Identity comes from scripts/fleet-role.py (exit 0 + "ORCHESTRATOR", else SUB) run on
$CLAUDE_CODE_SESSION_ID and $CODEX_THREAD_ID. Both variables absent = a human terminal =
allowed (Shane's escape hatch). Present but empty or malformed, or the checker failing or
hanging = refused (fail closed). A FLEET_ROLE env var is never trusted.

The checker is never run from the working tree, which a merge has already rewritten by
the time this hook runs: its blobs (fleet-role.py and the fleet_codex_rpc.py it imports)
are read from the transaction's old value of the LOCAL refs/heads/main (never a
remote-tracking ref or FETCH_HEAD) into a fresh temp dir, and run there with python3 -E -s
(not -I: that drops the script dir from sys.path and the sibling import fails). Every git
inspection uses --no-replace-objects. Recreating a deleted main takes the checker from
main's reflog; with no reflog (git deletes it with the ref) only a human may recreate main.
While main is symbolic, every ref in its chain (main -> ... -> leaf) is watched.

Live export (LUCY-p122j): ~/.claude's main checkout is the running harness, so an
uncommitted edit there would run before any ref moved. Gates therefore run from
<git-common-dir>/live/current, a read-only copy of GATE_PATHS at committed main, through
<git-common-dir>/live/run-gate, which checks the copy against main's blobs before every
run. In state "committed" this hook refreshes the copy for main's new value, so it moves
only when main does. The export is written blob by blob from main's tree (never git archive,
which .gitattributes can change), refuses a symlink, and only ever holds main's current tip:
the --export CLI (install.sh, live-export.sh) also needs the orchestrator or a human.

This file runs with python3 -I -S (no PYTHON* env, no cwd or user site on sys.path, no
site import) and re-execs itself that way if started otherwise.

Install with scripts/git-hooks/install.sh (orchestrator only): it copies the committed blob
into the absolute common hooks dir, points core.hooksPath there (so linked worktrees and
local pushes run it too) and makes the first export.

Residual routes (tracked in LUCY-4oxj3): `git branch -C/-M` onto main, `git -c
core.hooksPath=...` overrides, and direct writes to packed-refs or ref files. Same-uid
writes inside the git dir: the installed hook, run-gate and .git/live can all be replaced or
chmod +w'd by any process running as Shane. run-gate's check catches a tampered export, not
a replaced run-gate or hook.
"""
import os
import sys

if __name__ == "__main__" and not (sys.flags.isolated and sys.flags.no_site):
    os.execv(sys.executable, [sys.executable, "-I", "-S", os.path.abspath(__file__)] + sys.argv[1:])

import hashlib  # noqa: E402
import re  # noqa: E402
import shutil  # noqa: E402
import stat  # noqa: E402
import subprocess  # noqa: E402
import tempfile  # noqa: E402

MAIN_REF = "refs/heads/main"
ZERO = "0" * 40

# Prefixes (ending "/") match a directory; anything else matches that exact path.
# scripts/risk_tier.py decides the land tier and tier_gates.py imports it, so it is a gate.
GATE_PATHS = (
    "references/review-lead/",
    "scripts/review-gate.sh",
    "scripts/review_gate.py",
    "scripts/fleet-dispatch.py",
    "scripts/fleet-land-codex.py",
    "scripts/fleet-role.py",
    "scripts/fleet_codex_rpc.py",
    "scripts/gate-watch.py",
    "scripts/gate-tier.py",
    "scripts/build-gate.py",
    "scripts/risk_tier.py",
    "scripts/live-export.sh",
    "scripts/git-hooks/",
    "skills/land-batch/",
    "skills/aestheticc-review/",
    "commands/goal.md",
    "commands/long-goal.md",
    "hooks/",
    "settings.json",
)

# The checker and the sibling module it may import, read from main's committed tree.
CHECKER = "scripts/fleet-role.py"
CHECKER_SIBLINGS = ("scripts/fleet_codex_rpc.py",)

# Longer than fleet-role's worst case: its Codex probe has three 15 s budgets. A timeout is
# a refusal. Tests may lower it, never raise it.
TIMEOUT_MAX_S = 60.0
TIMEOUT_TEST_ENV = "WQN96_TEST_TIMEOUT_S"

# Claude session ids and Codex thread ids are both UUIDs. A leading hex digit also keeps
# the id from being read as a flag: the checker treats any "--x" argument as an option.
AGENT_ID_RE = re.compile(r"[0-9a-fA-F][0-9a-fA-F-]{7,63}")
AGENT_ID_VARS = ("CLAUDE_CODE_SESSION_ID", "CODEX_THREAD_ID")
OID_RE = re.compile(r"[0-9a-f]{40}|[0-9a-f]{64}")

LIVE = "live"
KEEP_EXPORTS = 3

RULE = (
    "Gate changes go on a branch: commit there, get the independent Astra fail-open "
    "review, and the orchestrator merges to main."
)


def is_gate_path(path):
    # A gate directory's own name counts too: a gitlink or file at "hooks" replaces hooks/.
    return any(path.startswith(g) or path == g[:-1] if g.endswith("/") else path == g
               for g in GATE_PATHS)


def git(*args, text=True):
    return subprocess.run(["git", "--no-replace-objects", *args], capture_output=True, text=text)


def main_tip():
    cur = git("rev-parse", "--verify", "-q", MAIN_REF + "^{commit}")
    return cur.stdout.strip() if cur.returncode == 0 else None


def symbolic_main():
    """The ref main points at when main is symbolic, else None."""
    out = git("symbolic-ref", "-q", MAIN_REF)
    return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else None


def symref_chain():
    """Every ref main's symbolic chain passes through, lowercased: main -> middle -> leaf.

    Empty when main is a direct ref. A loop or a chain deeper than 10 ends the walk; the
    refs seen so far are still all watched.
    """
    chain, ref = [], MAIN_REF
    for _ in range(10):
        out = git("symbolic-ref", "--no-recurse", "-q", ref)
        target = out.stdout.strip() if out.returncode == 0 else ""
        if not target or target.lower() in chain or target.lower() == MAIN_REF:
            break
        chain.append(target.lower())
        ref = target
    return chain


def common_dir():
    out = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if out.returncode != 0 or not out.stdout.strip():
        raise RuntimeError("cannot find the git common dir")
    return out.stdout.strip()


def is_commit(oid):
    return bool(oid) and OID_RE.fullmatch(oid) is not None and \
        git("cat-file", "-e", oid + "^{commit}").returncode == 0


def live_current():
    """The commit the live export holds, or None."""
    try:
        live = os.path.join(common_dir(), LIVE)
        oid = os.readlink(os.path.join(live, "current"))
    except (OSError, RuntimeError):
        return None
    # A bare oid naming a real directory beside the link: never a path, never dangling.
    if OID_RE.fullmatch(oid) is None:
        return None
    target = os.path.join(live, oid)
    if os.path.islink(target) or not os.path.isdir(target):
        return None
    return oid if is_commit(oid) else None


def recreate_anchor():
    """Main's last value before it was deleted, from the reflog, else None (only a human may
    then recreate it). Never the live export: its link is not proof of main's history."""
    log = git("reflog", "show", "--format=%H", MAIN_REF)
    if log.returncode == 0:
        for oid in log.stdout.split():
            if oid != ZERO and is_commit(oid):
                return oid
    return None


def changed_paths(old, new):
    """Paths that differ between old and new. None when that can't be worked out."""
    # Neither repo config nor an incoming .gitmodules (ignore = all) may hide a path: a
    # gitlink under a gate prefix is a gate change like any file.
    out = git("-c", "diff.ignoreSubmodules=none", "-c", "core.quotePath=false",
              "-c", "diff.relative=false", "diff", "-z", "--name-only", "--no-renames",
              "--ignore-submodules=none", "--no-relative", "--no-ext-diff", "--no-textconv",
              old, new)
    if out.returncode != 0:
        return None
    # -z: unquoted names, so "hooks/résumé.py" still starts with "hooks/".
    return [p for p in out.stdout.split("\0") if p]


def timeout_s():
    try:
        wanted = float(os.environ.get(TIMEOUT_TEST_ENV, TIMEOUT_MAX_S))
    except ValueError:
        return TIMEOUT_MAX_S
    return min(wanted, TIMEOUT_MAX_S) if wanted > 0 else TIMEOUT_MAX_S


def materialise_checker(tip, dest):
    """Write the checker blobs from commit `tip` into dest. Returns the checker path or None."""
    for rel in (CHECKER,) + CHECKER_SIBLINGS:
        blob = git("show", "%s:%s" % (tip, rel), text=False)
        if blob.returncode != 0 or not blob.stdout.strip():
            if rel == CHECKER:
                return None
            continue
        path = os.path.join(dest, os.path.basename(rel))
        with open(path, "wb") as fh:
            fh.write(blob.stdout)
    return os.path.join(dest, os.path.basename(CHECKER))


def is_orchestrator(agent_id, checker):
    # Exactly one argument, the validated id: its informational flags (--who, --release)
    # exit 0 without proving anything. cwd and the script dir are the temp dir, so the
    # sibling import resolves to the committed blob.
    try:
        res = subprocess.run(
            [sys.executable, "-E", "-s", checker, agent_id],
            capture_output=True, text=True, timeout=timeout_s(),
            cwd=os.path.dirname(checker),
        )
    except (OSError, subprocess.SubprocessError):
        return False
    lines = res.stdout.splitlines()
    return res.returncode == 0 and bool(lines) and lines[0].strip() == "ORCHESTRATOR"


def caller_role(trusted_tip):
    """'human', 'orchestrator', or 'sub' (any doubt is 'sub').

    Every agent id variable present must hold a well-formed id that is the orchestrator:
    a Codex worker launched from the Claude orchestrator inherits its
    CLAUDE_CODE_SESSION_ID and must not pass as it. Only one session holds the role, so
    carrying both ids means 'sub'. A variable that is set but empty is not a human.
    """
    present = [os.environ[v] for v in AGENT_ID_VARS if v in os.environ]
    if not present:
        return "human"
    if not all(AGENT_ID_RE.fullmatch(agent_id) for agent_id in present):
        return "sub"
    if trusted_tip is None:
        return "sub"
    tmp = tempfile.mkdtemp(prefix="wqn96-checker-")
    try:
        checker = materialise_checker(trusted_tip, tmp)
        if checker is None:
            return "sub"
        if all(is_orchestrator(agent_id, checker) for agent_id in present):
            return "orchestrator"
        return "sub"
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def blob_id(data, algo):
    return hashlib.new(algo, b"blob %d\0" % len(data) + data).hexdigest()


def object_algo():
    out = git("rev-parse", "--show-object-format")
    return "sha256" if out.stdout.strip() == "sha256" else "sha1"


def gate_tree(oid):
    """{relpath: (mode, blob)} for every gate path in commit oid. None if git fails."""
    out = git("ls-tree", "-r", "-z", "--full-tree", oid, "--", *GATE_PATHS)
    if out.returncode != 0:
        return None
    tree = {}
    for entry in out.stdout.split("\0"):
        if not entry:
            continue
        meta, path = entry.split("\t", 1)
        mode, kind, blob = meta.split()
        if kind == "blob" and is_gate_path(path):
            tree[path] = (mode, blob)
    return tree


def export_drift(root, oid):
    """Empty list when the files under root are exactly main@oid's gate blobs; else the problems."""
    tree = gate_tree(oid)
    if tree is None:
        return ["cannot list %s" % oid]
    algo = object_algo()
    problems, seen = [], set()
    for dirpath, dirs, files in os.walk(root):
        for name in files + [d for d in dirs if os.path.islink(os.path.join(dirpath, d))]:
            full = os.path.join(dirpath, name)
            rel = os.path.relpath(full, root)
            seen.add(rel)
            if rel not in tree:
                problems.append("extra file %s" % rel)
                continue
            mode, blob = tree[rel]
            if mode == "120000" or stat.S_ISLNK(os.lstat(full).st_mode):
                problems.append("symlink %s" % rel)
                continue
            if not stat.S_ISREG(os.lstat(full).st_mode):
                problems.append("not a file %s" % rel)
                continue
            with open(full, "rb") as fh:
                ok = blob_id(fh.read(), algo) == blob
            if not ok:
                problems.append("changed %s" % rel)
    problems.extend("missing %s" % rel for rel in sorted(set(tree) - seen))
    return problems


def make_writable(path):
    for dirpath, dirs, files in os.walk(path):
        os.chmod(dirpath, 0o755)
        for name in files:
            full = os.path.join(dirpath, name)
            if not os.path.islink(full):
                os.chmod(full, stat.S_IMODE(os.lstat(full).st_mode) | stat.S_IWUSR)


def remove_tree(path):
    if os.path.isdir(path) and not os.path.islink(path):
        make_writable(path)
        shutil.rmtree(path, ignore_errors=True)


def make_read_only(path):
    for dirpath, dirs, files in os.walk(path, topdown=False):
        for name in files:
            full = os.path.join(dirpath, name)
            if not os.path.islink(full):
                os.chmod(full, stat.S_IMODE(os.lstat(full).st_mode) & ~0o222)
        os.chmod(dirpath, 0o555)


def write_blobs(root, tree):
    """Write each {relpath: (mode, blob)} under root from the object store, exactly.

    Not git archive: export-ignore / export-subst in .gitattributes would change what it
    writes. A symlink is refused (it could point back into the checkout).
    """
    links = sorted(rel for rel, (mode, _) in tree.items() if mode == "120000")
    if links:
        raise RuntimeError("gate path is a symlink: %s" % ", ".join(links[:5]))
    rels = sorted(tree)
    if not rels:
        return
    batch = subprocess.run(["git", "--no-replace-objects", "cat-file", "--batch"],
                           input=b"".join(tree[r][1].encode() + b"\n" for r in rels),
                           capture_output=True)
    if batch.returncode != 0:
        raise RuntimeError("git cat-file --batch failed: %s" % batch.stderr.decode(errors="replace"))
    out, pos = batch.stdout, 0
    for rel in rels:
        mode, blob = tree[rel]
        end = out.index(b"\n", pos)
        header = out[pos:end].decode().split()
        if len(header) != 3 or header[0] != blob or header[1] != "blob":
            raise RuntimeError("cat-file gave %r for %s" % (header, rel))
        size = int(header[2])
        data = out[end + 1:end + 1 + size]
        pos = end + 1 + size + 1
        full = os.path.join(root, rel)
        os.makedirs(os.path.dirname(full), exist_ok=True)
        fd = os.open(full, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                     0o755 if mode == "100755" else 0o644)
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)


def export(oid):
    """Write main@oid's gate paths to <common>/live/<oid>, read-only, and point current at it.

    The copy is checked blob by blob before current moves, so a failed export leaves the old
    one in place. Keeps the newest KEEP_EXPORTS exports. Returns 0 or 1.
    """
    if not is_commit(oid):
        sys.stderr.write("LIVE EXPORT FAILED (LUCY-wqn96): %s is not a commit\n" % oid)
        return 1
    if oid != main_tip():
        # Whatever the route (CLI, live-export.sh, a hand-fed "committed" line), live/ only
        # ever holds main's current tip.
        sys.stderr.write("LIVE EXPORT FAILED (LUCY-wqn96): %s is not main's tip\n" % oid)
        return 1
    live = os.path.join(common_dir(), LIVE)
    os.makedirs(live, exist_ok=True)
    final = os.path.join(live, oid)
    if os.path.isdir(final) and export_drift(final, oid):
        remove_tree(final)
    if not os.path.isdir(final):
        tmp = tempfile.mkdtemp(prefix=".tmp-", dir=live)
        try:
            tree = gate_tree(oid)
            if tree is None:
                raise RuntimeError("cannot list %s" % oid)
            write_blobs(tmp, tree)
            problems = export_drift(tmp, oid)
            if problems:
                raise RuntimeError("export does not match %s: %s" % (oid, "; ".join(problems[:5])))
            make_read_only(tmp)
            os.rename(tmp, final)
        except Exception as exc:  # noqa: BLE001 - every failure leaves current where it was
            remove_tree(tmp)
            sys.stderr.write("LIVE EXPORT FAILED (LUCY-wqn96): %s\n" % exc)
            return 1
    link_tmp = os.path.join(live, ".current-%d" % os.getpid())
    if os.path.lexists(link_tmp):
        os.unlink(link_tmp)
    os.symlink(oid, link_tmp)
    os.replace(link_tmp, os.path.join(live, "current"))
    exports = [d for d in os.listdir(live)
               if OID_RE.fullmatch(d) and os.path.isdir(os.path.join(live, d)) and d != oid]
    exports.sort(key=lambda d: os.lstat(os.path.join(live, d)).st_mtime, reverse=True)
    for stale in exports[KEEP_EXPORTS - 1:]:
        remove_tree(os.path.join(live, stale))
    return 0


def prepared(lines):
    blocked = []
    tip = main_tip()
    sym = symbolic_main()
    # Every link: with main -> middle -> leaf, moving middle moves main too.
    watched = {MAIN_REF} | set(symref_chain())
    trusted = None  # the checker comes from main's value before this transaction
    for line in lines:
        parts = line.split(" ", 2)
        # Case-folded: on macOS refs/heads/MAIN is the same loose ref file as main.
        if len(parts) != 3 or parts[2].lower() not in watched:
            continue
        old, new, _ = parts
        if sym:
            # main must be a direct ref: a commit on its target would move main unchecked.
            blocked.append("(main is a symbolic ref to %s)" % sym)
            trusted = trusted or tip
            continue
        if old.startswith("ref:") or new.startswith("ref:"):
            blocked.append("(makes main a symbolic ref)")
            trusted = trusted or tip
            continue
        if old == ZERO:
            # update-ref without an expected value sends a zero old: use main's current tip.
            old = tip or ZERO
        if old != ZERO:
            trusted = trusted or old
        if old == new:
            continue
        if old == ZERO:
            trusted = trusted or recreate_anchor()
            blocked.append("(creates main)")
            continue
        if new == ZERO:
            blocked.append("(deletes main)")
            continue
        paths = changed_paths(old, new)
        if paths is None:
            blocked.append("(could not diff %s..%s)" % (old[:12], new[:12]))
            continue
        blocked.extend(p for p in paths if is_gate_path(p))
    if not blocked:
        return 0
    if caller_role(trusted) in ("human", "orchestrator"):
        return 0
    sys.stderr.write(
        "REFUSED (LUCY-wqn96): this session is not the orchestrator, so it cannot move "
        "main onto a change to gate paths, or create or delete main:\n"
        + "".join("  %s\n" % p for p in sorted(set(blocked)))
        + RULE + "\n"
    )
    return 1


def committed(lines):
    """Refresh the live export for main's new value. Never fails the (already done) update."""
    for line in lines:
        parts = line.split(" ", 2)
        if len(parts) == 3 and parts[2].lower() == MAIN_REF and OID_RE.fullmatch(parts[1]) \
                and parts[1] != ZERO:
            try:
                export(parts[1])
            except Exception as exc:  # noqa: BLE001
                sys.stderr.write("LIVE EXPORT FAILED (LUCY-wqn96): %s\n" % exc)
    return 0


def main(argv):
    if argv[:1] == ["--gate-paths"]:
        sys.stdout.write("".join(p + "\n" for p in GATE_PATHS))
        return 0
    if argv[:1] == ["--export"] and len(argv) == 2:
        # install.sh / live-export.sh: only the orchestrator or a human; export() itself
        # refuses anything but main's tip.
        if caller_role(main_tip()) not in ("human", "orchestrator"):
            sys.stderr.write("LIVE EXPORT REFUSED (LUCY-wqn96): only the orchestrator refreshes the export\n")
            return 1
        oid = git("rev-parse", "--verify", "-q", "--end-of-options", argv[1] + "^{commit}").stdout.strip()
        return export(oid) if oid else 1
    if argv == ["--check-orchestrator"]:
        # install.sh: may this caller install? Same identity rule as a gate move.
        return 0 if caller_role(main_tip()) in ("human", "orchestrator") else 1
    if argv[:1] == ["prepared"]:
        return prepared(sys.stdin.read().splitlines())
    if argv[:1] == ["committed"]:
        return committed(sys.stdin.read().splitlines())
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
